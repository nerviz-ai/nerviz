<archunit-fragment>
<!--
EXEMPLAR — what `archunit-installer` merges into a Maven build. A fragment: each block below
goes into the element of the same name that already exists, never as a second copy of it. The
<archunit-fragment> root exists only so the file is one well-formed XML document; it is not
copied.

Placement:
  - the property and the dependencyManagement entry — the ROOT pom.xml (single-module: the only
    one).
  - the bare dependency, without <version> — only the module with `contains_main: true`, the
    one that sees every class (single-module: the root pom).
  - the `check` execution — the root pom's existing jacoco-maven-plugin, beside the
    `prepare-agent` and `report` executions.

Version: repo1.maven.org's maven-metadata.xml <release> for archunit-junit5, at install time,
never from memory. ArchUnit is not in the Spring Boot BOM, so the version is explicit.

Limits: .claude/rules/testing.md, Coverage. Never lowered to make the build pass. Do not touch
the <excludes> already configured on the plugin.
-->

<properties>
  <archunit.version><!-- resolved: com/tngtech/archunit/archunit-junit5/maven-metadata.xml <release> --></archunit.version>
</properties>

<dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</dependencyManagement>

<dependencies>
  <dependency>
    <groupId>com.tngtech.archunit</groupId>
    <artifactId>archunit-junit5</artifactId>
    <scope>test</scope>
  </dependency>
</dependencies>

<execution>
  <id>check</id>
  <phase>verify</phase>
  <goals><goal>check</goal></goals>
  <configuration>
    <rules>
      <rule>
        <element>BUNDLE</element>
        <limits>
          <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit>
          <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.70</minimum></limit>
        </limits>
      </rule>
    </rules>
  </configuration>
</execution>
</archunit-fragment>
