// EXEMPLAR — ArchUnit tests. Lives in the module with `contains_main: true` (bootstrap),
// in `src/test/java`, because it's the only module that sees every class on the classpath.
//
// This is the deterministic half of the enforcement. The `ArchHook.java check` hook blocks
// in the editor; these rules block in CI and on the machine of whoever isn't using Claude Code.
//
// The package names below are `hexagonal` blueprint's. When generating, replace them
// with the active blueprint's real `packages.map` values — never copy them literally.
// A blueprint with no `application.port.out` doesn't get the rule that names it.
//
// Dependency direction: one rule per line of the blueprint's `dependency_rules.forbidden`.
// Domain purity mirrors the blueprint's `forbidden_imports`.
package com.exemplo.minhaapi;

import static com.tngtech.archunit.library.GeneralCodingRules.NO_CLASSES_SHOULD_ACCESS_STANDARD_STREAMS;
import static com.tngtech.archunit.library.GeneralCodingRules.NO_CLASSES_SHOULD_THROW_GENERIC_EXCEPTIONS;
import static com.tngtech.archunit.library.GeneralCodingRules.NO_CLASSES_SHOULD_USE_FIELD_INJECTION;
import static com.tngtech.archunit.library.GeneralCodingRules.NO_CLASSES_SHOULD_USE_JAVA_UTIL_LOGGING;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.fields;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noClasses;
import static com.tngtech.archunit.lang.syntax.ArchRuleDefinition.noFields;

import com.tngtech.archunit.base.DescribedPredicate;
import com.tngtech.archunit.core.domain.JavaClass;
import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;
import com.tngtech.archunit.lang.ArchRule;
import com.tngtech.archunit.library.dependencies.SlicesRuleDefinition;
import java.time.Clock;
import java.time.LocalDate;
import java.time.LocalDateTime;

@AnalyzeClasses(packages = "com.exemplo.minhaapi", importOptions = ImportOption.DoNotIncludeTests.class)
class ArchitectureTest {

    /** Dependency direction (`.claude/rules/architecture-ddd.md`). */
    @ArchTest
    static final ArchRule domain_knows_no_one = noClasses()
            .that().resideInAPackage("..domain..")
            .should().dependOnClassesThat()
            .resideInAnyPackage("..application..", "..adapter..", "..bootstrap..");

    @ArchTest
    static final ArchRule application_does_not_know_adapters = noClasses()
            .that().resideInAPackage("..application..")
            .should().dependOnClassesThat()
            .resideInAnyPackage("..adapter..", "..bootstrap..");

    @ArchTest
    static final ArchRule adapters_do_not_talk_to_each_other = SlicesRuleDefinition
            .slices().matching("..adapter.(*)..")
            .should().notDependOnEachOther();

    @ArchTest
    static final ArchRule no_cycles_between_packages = SlicesRuleDefinition
            .slices().matching("com.exemplo.minhaapi.(*)..")
            .should().beFreeOfCycles();

    /** Domain purity (`.claude/rules/architecture-ddd.md`). */
    @ArchTest
    static final ArchRule domain_has_no_framework = noClasses()
            .that().resideInAPackage("..domain..")
            .should().dependOnClassesThat()
            .resideInAnyPackage("org.springframework..", "jakarta..", "com.fasterxml.jackson..", "tools.jackson..");

    @ArchTest
    static final ArchRule domain_has_no_system_clock = noClasses()
            .that().resideInAPackage("..domain..")
            .should().callMethod(LocalDateTime.class, "now")
            .orShould().callMethod(LocalDate.class, "now")
            .orShould().callMethod(Clock.class, "systemDefaultZone")
            .because("Clock is injected — see rules/architecture-ddd.md");

    /**
     * The domain throws and returns; the adapter or application service logs
     * (`.claude/rules/logging.md` § Format and level). Read from the bytecode, so a Lombok
     * {@code @Slf4j} counts too: its annotation is gone after compilation, the
     * {@code org.slf4j.Logger} field it generated is not. JUL is already refused everywhere by
     * {@code no_java_util_logging} below.
     */
    @ArchTest
    static final ArchRule domain_does_not_log = noClasses()
            .that().resideInAPackage("..domain..")
            .should().dependOnClassesThat()
            .resideInAnyPackage("org.slf4j..", "ch.qos.logback..", "org.apache.logging..", "org.apache.commons.logging..")
            .because("a catch in the domain rethrows or answers; the log line belongs to the layer that knows"
                    + " what the event means outside (rules/logging.md § Format and level)");

    /** Composition (`.claude/rules/architecture-ddd.md` § Composition). */
    @ArchTest
    static final ArchRule no_field_injection = NO_CLASSES_SHOULD_USE_FIELD_INJECTION;

    @ArchTest
    static final ArchRule no_service_locator = noClasses()
            .that().resideOutsideOfPackage("..bootstrap..")
            .should().dependOnClassesThat()
            .haveFullyQualifiedName("org.springframework.context.ApplicationContext");

    /** Naming (`.claude/rules/naming.md`). */
    @ArchTest
    static final ArchRule no_impl_suffix = noClasses()
            .should().haveSimpleNameEndingWith("Impl")
            .because("the name says the role, not that it's the implementation of something");

    /**
     * `.and().areNotAssignableTo(Record.class)` on the two package-based role rules: a
     * record is a value carrier — a use case's `*Command`, a port's `*Record` or result —
     * never a role, and it lives next to the role it serves. ArchUnit imports nested
     * classes too, so without it a `SendResult` declared inside the port interface fails
     * "should be interfaces", and a `Command` fails the suffix rule. A plain class out of
     * pattern still fails both.
     */
    @ArchTest
    static final ArchRule outbound_ports_are_interfaces = classes()
            .that().resideInAPackage("..application.port.out..")
            .and().areNotAssignableTo(Record.class)
            .should().beInterfaces();

    /**
     * `.and().haveSimpleNameNotEndingWith("package-info")` on every rule below:
     * `project-bootstrap` generates a `package-info.java` in every package, ArchUnit
     * imports it as a class, and a naming rule with no exclusion fails on it on the
     * very first run — the file isn't named `*Service`/`*Controller`/`*Entity` because
     * it isn't one.
     */
    @ArchTest
    static final ArchRule use_case_implementations = classes()
            .that().resideInAPackage("..application.service..")
            .and().haveSimpleNameNotEndingWith("package-info")
            .and().areNotAssignableTo(Record.class)
            .should().haveSimpleNameEndingWith("Service");

    @ArchTest
    static final ArchRule controllers_in_rest_adapter = classes()
            .that().areAnnotatedWith("org.springframework.web.bind.annotation.RestController")
            .and().haveSimpleNameNotEndingWith("package-info")
            .should().resideInAPackage("..adapter.in.rest..")
            .andShould().haveSimpleNameEndingWith("Controller");

    /**
     * The trailing two dots are deliberate: the persistence adapter is organized as one
     * subpackage per aggregate (`@.claude/rules/persistence.md` § Boundary), so the
     * entity of `User` resides in `..adapter.out.persistence.user`. Narrowing this to a
     * single-level glob would fail every project that follows the rule.
     */
    @ArchTest
    static final ArchRule jpa_entities_have_entity_suffix = classes()
            .that().areAnnotatedWith("jakarta.persistence.Entity")
            .and().haveSimpleNameNotEndingWith("package-info")
            .should().haveSimpleNameEndingWith("Entity")
            .andShould().resideInAPackage("..adapter.out.persistence..");

    /**
     * Persistence mapping (`.claude/rules/persistence.md`). Both bugs the two rules below
     * catch pass compilation and most tests: the first degrades {@code save()} to
     * {@code merge()} and swallows primary-key collisions, the second only fails at context
     * startup.
     */
    private static final DescribedPredicate<JavaClass> HAVE_ASSIGNED_ID = DescribedPredicate.describe(
            "have an @Id without @GeneratedValue",
            javaClass -> javaClass.getAllFields().stream().anyMatch(field ->
                    field.isAnnotatedWith("jakarta.persistence.Id")
                            && !field.isAnnotatedWith("jakarta.persistence.GeneratedValue")));

    /** Empty is allowed: a project whose ids are all generated has nothing to check. */
    @ArchTest
    static final ArchRule assigned_ids_implement_persistable = classes()
            .that().areAnnotatedWith("jakarta.persistence.Entity")
            .and(HAVE_ASSIGNED_ID)
            .should().implement("org.springframework.data.domain.Persistable")
            .because("without isNew, Spring Data merges instead of persisting (§ Identity and keys)")
            .allowEmptyShould(true);

    /**
     * Postgres only: `@Lob String` maps to `oid`, not `text`. Drop this rule when the
     * blueprint's database is another engine. Empty is the expected state: no {@code @Lob}
     * field at all.
     */
    @ArchTest
    static final ArchRule no_lob_on_string = noFields()
            .that().areAnnotatedWith("jakarta.persistence.Lob")
            .should().haveRawType(String.class)
            .because("a bare String already maps to text (§ Mapping)")
            .allowEmptyShould(true);

    /** Code quality (`.claude/rules/code-quality.md`). */
    @ArchTest
    static final ArchRule no_generic_exceptions = NO_CLASSES_SHOULD_THROW_GENERIC_EXCEPTIONS;

    @ArchTest
    static final ArchRule private_final_fields_in_domain = fields()
            .that().areDeclaredInClassesThat().resideInAPackage("..domain..")
            .and().areNotStatic()
            .should().bePrivate()
            .andShould().beFinal()
            .because("value objects and aggregates are immutable");

    @ArchTest
    static final ArchRule no_java_util_logging = NO_CLASSES_SHOULD_USE_JAVA_UTIL_LOGGING;

    @ArchTest
    static final ArchRule no_system_out = NO_CLASSES_SHOULD_ACCESS_STANDARD_STREAMS;
}
