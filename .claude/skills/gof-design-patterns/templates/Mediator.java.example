// Exemplar: Mediator. Coordinates several independent reactions to one event without
// them referencing each other directly. Check first whether an application service
// already plays this role — a second one here usually means a missing use-case
// boundary, not a missing pattern. Not Observer: these reactions are called directly,
// synchronously, by application code — not published from inside an aggregate to
// decoupled listeners (that's Domain Events, already covered elsewhere in this catalog).
package com.example.application.order;

import com.example.application.port.out.NotificationPort;
import com.example.application.port.out.WarehousePort;
import com.example.domain.model.order.OrderShipped;
import java.util.List;
import lombok.AccessLevel;
import lombok.experimental.FieldDefaults;

// --- each colleague knows only its own job, never the others
public interface ShipmentReaction {

    void reactTo(OrderShipped event);
}

@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
public final class NotifyCustomerReaction implements ShipmentReaction {

    NotificationPort notifications;

    public NotifyCustomerReaction(NotificationPort notifications) {
        this.notifications = notifications;
    }

    @Override
    public void reactTo(OrderShipped event) {
        notifications.sendShipmentNotice(event.orderId(), event.customerId());
    }
}

@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
public final class ReleaseWarehouseHoldReaction implements ShipmentReaction {

    WarehousePort warehouse;

    public ReleaseWarehouseHoldReaction(WarehousePort warehouse) {
        this.warehouse = warehouse;
    }

    @Override
    public void reactTo(OrderShipped event) {
        warehouse.releaseHold(event.orderId());
    }
}

// --- the mediator
/**
 * Colleagues are wired here, never against each other. Adding a third reaction touches
 * this list, not NotifyCustomerReaction or the other one.
 */
@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
public final class OrderShippedMediator {

    List<ShipmentReaction> reactions;

    public OrderShippedMediator(List<ShipmentReaction> reactions) {
        this.reactions = List.copyOf(reactions);
    }

    public void handle(OrderShipped event) {
        reactions.forEach(reaction -> reaction.reactTo(event));
    }
}
