/*
 * EXEMPLAR — predefined masking regexes for `@MaskSensitiveData`. `@Getter` on `regex`
 * is allowed under `.claude/rules/lombok.md`: `String` is immutable.
 * Compilable as-is — not pseudo-code.
 *
 * Lives in the `enums` sub-package of `commons.logging`, its own small territory since
 * `MaskSensitiveData` (`annotations`) is its only consumer.
 */
package com.exemplo.minhaapi.commons.logging.enums;

import lombok.AccessLevel;
import lombok.Getter;
import lombok.RequiredArgsConstructor;
import lombok.experimental.FieldDefaults;

@Getter
@RequiredArgsConstructor
@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
public enum MaskedType {

    ALL("\\S"),
    EMAIL(".(?=.{4})(?=[^@])(?=[^@]{4})."),
    DOCUMENT(".(?=.{3})"),
    NAME(".(?=[^ ])(?=[^ ]{2})."),
    DATE(".(?=[^ \\\\/.-].{3})."),
    ADDRESS(".(?=.{3})[^, ]"),
    ZIP_CODE(".(?=.{3})[^-]"),
    NUMBER("\\d"),
    TELEPHONE(".(?=.{2})[^-]");

    String regex;
}
