# EXEMPLAR — application.yml for the module with `contains_main: true`.
# Each block is tagged with the feature that justifies it. If that feature isn't
# active in the blueprint, the block doesn't go in — don't copy the whole file blindly.
# Tested to compile and start up with Spring Boot 4 · Java 21.

spring:
  application:
    name: minha-api

  # Always — the build targets JDK 21 or later (.claude/rules/virtual-threads.md). Virtual
  # threads are daemon threads: keep-alive holds the JVM up for an application whose only work
  # is a scheduler or a listener.
  threads:
    virtual:
      enabled: true
  main:
    keep-alive: true

  # feature: persistence-jpa
  # The untracked `.env` at the project root: docker compose reads it for the services, and
  # this import hands the host run (the IDE, `./mvnw spring-boot:run`) the same values, so
  # `DB_PASSWORD` lives in one place and never in this file (`.claude/rules/secrets.md`).
  # Optional, so a deployment that sets real environment variables needs no file; those win
  # over it anyway. Multi-module: the run's working directory is the module, so the list is
  # `optional:file:../.env[.properties],optional:file:.env[.properties]` there.
  config:
    import: optional:file:.env[.properties]
  # One set of variables with the compose service, same names and same defaults:
  # `minha_api` is the artifact name with `-` replaced by `_`, the literal
  # docker-architect's service template carries too. `ArchHook.java compose` warns when the
  # two disagree.
  datasource:
    url: ${DB_URL:jdbc:postgresql://localhost:${DB_PORT:5432}/${DB_NAME:minha_api}}
    username: ${DB_USERNAME:minha_api}
    password: ${DB_PASSWORD}
  jpa:
    open-in-view: false
    hibernate:
      # The schema belongs to Flyway. Hibernate never alters it.
      ddl-auto: validate

  # feature: flyway
  flyway:
    enabled: true
    locations: classpath:db/migration

  # feature: pagination — Spring Data doesn't reject an oversized `size` on its own;
  # without this, api-rest.md's "above the max is 400" contract is unenforced.
  data:
    web:
      pageable:
        max-page-size: 100

# feature: actuator
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      probes:
        enabled: true

# feature: openapi
springdoc:
  swagger-ui:
    path: /swagger-ui.html
  api-docs:
    path: /v3/api-docs

logging:
  level:
    root: INFO
