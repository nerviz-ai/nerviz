/*
 * EXEMPLAR — Quartz over a clustered JDBC store.
 * The answer when a missed fire must be caught up after downtime, or schedules are created at
 * runtime from data, and more than one instance runs. Quartz persists its triggers and applies
 * a misfire policy; the cluster shares one store, so one instance runs each fire.
 * Not the answer for a static job with no catch-up need: about eleven `QRTZ_*` tables for what
 * `@Scheduled` + a lock does (`references/tool-decision-matrix.md` § 2).
 * Form reference for the executor agent; not a file to copy verbatim.
 * Rules: `.claude/rules/scheduling.md` · `.claude/rules/architecture-ddd.md` (§ Adapters)
 *
 * WHAT THIS EXEMPLAR SHOWS:
 *  - the `Job` is a trigger like any other: it calls ONE inbound port. Quartz instantiates it
 *    through Spring's `SpringBeanJobFactory` (Boot's autoconfiguration), so constructor
 *    injection works — no `JobDataMap` lookups for dependencies;
 *  - `@DisallowConcurrentExecution` — one execution of this `JobDetail` at a time, across the
 *    cluster. Without it a slow run overlaps the next fire;
 *  - the misfire instruction is chosen, not defaulted: the partial's § 4 says whether a missed
 *    fire runs once on recovery or is dropped;
 *  - the schedule is still configuration, and the `JobDetail` is durable.
 *
 * SCHEMA. `spring.quartz.jdbc.initialize-schema: never`. The `QRTZ_*` tables are a schema
 * requirement in the partial's § 6 — vendor DDL for the database in use — and
 * `persistence-architect` writes them as a migration, like every other table in the project.
 * Letting Quartz create them makes the only unversioned tables in the schema.
 *
 * GATE. The whole scheduler is switched by `spring.quartz.auto-startup`, which the test profile
 * sets to `false` — the same role `app.*.enabled` plays for `@Scheduled`.
 *
 * DEPENDENCY (partial § 7): org.springframework.boot:spring-boot-starter-quartz — managed by the
 * Boot parent, no version.
 *
 * Each `// --- <File>.java` block is its own file, in the scheduling package.
 *
 * application.yml — Quartz's own keys pass through `spring.quartz.properties`:
 *
 * spring:
 *   quartz:
 *     job-store-type: jdbc
 *     jdbc:
 *       initialize-schema: never          # the migration owns the QRTZ_* tables
 *     overwrite-existing-jobs: true       # a changed cron in config replaces the stored one
 *     properties:
 *       org.quartz.scheduler.instanceId: AUTO
 *       org.quartz.jobStore.isClustered: true
 *       org.quartz.jobStore.clusterCheckinInterval: 15000
 *       org.quartz.threadPool.threadCount: 4
 *
 * application-test.yml:
 *
 * spring:
 *   quartz:
 *     auto-startup: false
 *
 * RUNTIME SCHEDULES. When the partial's § 1 says schedules are created from data (a reminder per
 * customer), the use case gets an outbound port — `ScheduleReminderPort` — implemented in this
 * package with the injected `Scheduler`: `scheduler.scheduleJob(jobDetail, trigger)`, identity
 * derived from the business key so a retry replaces instead of duplicating. The application
 * layer never sees a Quartz type.
 */

// --- SettleMerchantPayoutsJob.java
package com.example.demo.adapter.in.scheduling;

import com.example.demo.application.port.in.payout.SettleMerchantPayouts;
import java.time.LocalDate;
import lombok.AccessLevel;
import lombok.RequiredArgsConstructor;
import lombok.experimental.FieldDefaults;
import org.quartz.DisallowConcurrentExecution;
import org.quartz.Job;
import org.quartz.JobExecutionContext;

@DisallowConcurrentExecution
@RequiredArgsConstructor(access = AccessLevel.PACKAGE)
@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
class SettleMerchantPayoutsJob implements Job {

    SettleMerchantPayouts settleMerchantPayouts;
    JobRunRecorder recorder;

    /**
     * The business date comes from the SCHEDULED fire time, not from "now": a fire caught up at
     * 09:00 after a night of downtime still settles the day it was scheduled for.
     */
    @Override
    public void execute(JobExecutionContext context) {
        LocalDate businessDate = LocalDate.ofInstant(
                context.getScheduledFireTime().toInstant(), SettlementCalendar.ZONE);
        recorder.run("settle-merchant-payouts", () -> settleMerchantPayouts.settle(businessDate));
    }
}

// --- QuartzSchedulingConfig.java
package com.example.demo.adapter.in.scheduling;

import org.quartz.CronScheduleBuilder;
import org.quartz.JobBuilder;
import org.quartz.JobDetail;
import org.quartz.Trigger;
import org.quartz.TriggerBuilder;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

@Configuration
class QuartzSchedulingConfig {

    /**
     * {@code requestRecovery()}: re-run on another node if the one executing dies mid-run —
     * only because the use case is idempotent per business date (partial § 4).
     */
    @Bean
    JobDetail settleMerchantPayoutsJobDetail() {
        return JobBuilder.newJob(SettleMerchantPayoutsJob.class)
                .withIdentity("settle-merchant-payouts")
                .storeDurably()
                .requestRecovery()
                .build();
    }

    /**
     * `withMisfireHandlingInstructionFireAndProceed`: a fire missed during downtime runs ONCE on
     * recovery, then the schedule continues. The alternative the partial may choose instead is
     * `withMisfireHandlingInstructionDoNothing` — skip it and wait for the next fire.
     */
    @Bean
    Trigger settleMerchantPayoutsTrigger(
            JobDetail settleMerchantPayoutsJobDetail,
            @Value("${app.jobs.settle-merchant-payouts.cron:0 0 1 * * ?}") String cron) {
        return TriggerBuilder.newTrigger()
                .forJob(settleMerchantPayoutsJobDetail)
                .withIdentity("settle-merchant-payouts")
                .withSchedule(CronScheduleBuilder.cronSchedule(cron)
                        .inTimeZone(java.util.TimeZone.getTimeZone(SettlementCalendar.ZONE))
                        .withMisfireHandlingInstructionFireAndProceed())
                .build();
    }
}
