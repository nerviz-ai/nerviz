/*
 * EXEMPLAR — Kafka producer adapter, Form A: publish after commit.
 * Implements the outbound port `domain-modeling` already declared for the event; doesn't
 * invent its own interface.
 * Form A is the default of `.claude/rules/messaging.md` § Publication timing: the
 * transaction commits, then this adapter sends. It accepts one loss window — an outage
 * between the commit and the send drops the event silently. When that is unacceptable, the
 * form is B and the exemplar is `OutboxRelayPublisher.java.example`; `SKILL.md` step 3,
 * first axis, is where the two are chosen between.
 * Form reference for the executor agent; not a file to copy verbatim.
 * Rules: `.claude/rules/messaging.md` (payload shape, idempotent producer, topic naming)
 *        `.claude/rules/architecture-ddd.md` (Adapters: translate, no business logic)
 *
 * WHAT THIS EXEMPLAR SHOWS:
 *  - the domain event never serializes directly: an explicit payload record, only the
 *    fields the consumer needs;
 *  - the aggregate id as the partition key, so events of the same aggregate stay ordered;
 *  - the adapter is the only class in the codebase that imports `KafkaTemplate`;
 *  - the payload becomes JSON text HERE, once, with Boot's `JsonMapper`, and the template
 *    only moves a `String` — the wire contract of `.claude/rules/messaging.md` § Topics and
 *    serialization. Form B's `OutboxAppender` does the same conversion at append time, so
 *    both publication forms put the same bytes on the wire and one consumer reads either.
 *    A `KafkaTemplate<String, OrderConfirmedPayload>` with a JSON value serializer is the
 *    shape this replaces: it cannot also carry the relay's already-serialized text without
 *    encoding it a second time (issue #58).
 *
 * WHAT'S NOT HERE: retry of the send — the producer client's own (`acks=all`, idempotence,
 * `application-kafka.yml.example`), not per-adapter code; retry and DLQ of whoever consumes —
 * `KafkaListenerErrorHandler.java.example`, the other side's. Schema registry — not assumed until a use
 * case needs it (`.claude/rules/messaging.md` § Topics and serialization).
 *
 * PACKAGE: one subpackage per event flow — `…messaging.orderconfirmed`,
 * `…messaging.stockreserved` — never a single flat `…messaging` holding every flow
 * (`.claude/rules/messaging.md` § Boundary). The unit is the flow, not the aggregate: one
 * event routinely crosses aggregates, and two events of one aggregate share nothing but their
 * source. The classes stay package-private, which after the split means one flow cannot see
 * another's payload: that is the point, and the way across is the port, not a `public`.
 *
 * Each `// --- <dir>/<File>.java` block is its own file, at that subpackage.
 */

// --- PublishOrderConfirmedPort.java (declared by domain-modeling, in application/port/out)
package com.example.demo.application.port.out;

import com.example.demo.domain.event.OrderConfirmed;

public interface PublishOrderConfirmedPort {

    void publish(OrderConfirmed event);
}

// --- orderconfirmed/OrderConfirmedPayload.java (adapter-local, never the domain event itself)
package com.example.demo.adapter.out.messaging.orderconfirmed;

import java.time.Instant;
import java.util.UUID;

public record OrderConfirmedPayload(UUID orderId, UUID customerId, Instant occurredAt) {

    static OrderConfirmedPayload from(com.example.demo.domain.event.OrderConfirmed event) {
        return new OrderConfirmedPayload(
                event.orderId().value(), event.customerId().value(), event.occurredAt());
    }
}

// --- orderconfirmed/OrderConfirmedPublisher.java
package com.example.demo.adapter.out.messaging.orderconfirmed;

import com.example.demo.application.port.out.PublishOrderConfirmedPort;
import com.example.demo.domain.event.OrderConfirmed;
import lombok.AccessLevel;
import lombok.RequiredArgsConstructor;
import lombok.experimental.FieldDefaults;
import org.springframework.kafka.core.KafkaTemplate;
import tools.jackson.databind.json.JsonMapper;

@RequiredArgsConstructor
@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
public class OrderConfirmedPublisher implements PublishOrderConfirmedPort {

    private static final String TOPIC = "orders.order.confirmed";

    KafkaTemplate<String, String> kafkaTemplate;

    /**
     * The `@Primary` bean Boot's Jackson autoconfiguration registers (Jackson 3 on Spring Boot 4)
     * — injected, never `new`-ed, so the application's Jackson settings apply.
     */
    JsonMapper jsonMapper;

    @Override
    public void publish(OrderConfirmed event) {
        String partitionKey = event.orderId().value().toString();
        String payload = jsonMapper.writeValueAsString(OrderConfirmedPayload.from(event));
        kafkaTemplate.send(TOPIC, partitionKey, payload);
    }
}
