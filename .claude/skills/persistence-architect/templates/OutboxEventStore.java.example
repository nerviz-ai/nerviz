/*
 * EXEMPLAR — persistence side of the transactional outbox (Form B). Form reference for the
 * executor agent; not a file to copy verbatim.
 * Rules: `.claude/rules/messaging.md` (§ Publication timing) · `.claude/rules/persistence.md`
 *        (§ Boundary, § Mapping, § Identity and keys) · `.claude/rules/architecture-ddd.md`
 *        (§ Adapters) · `.claude/rules/lombok.md` (`@Data` and `@Setter` forbidden)
 *
 * WHAT THIS EXEMPLAR SHOWS: the table `outbox_events` mapped, and the read/mark side of it
 * served through `OutboxRelayGateway`. Table itself: `templates/OutboxEventTable.sql.example`.
 *
 * WHAT IT DOES NOT DECLARE, ON PURPOSE. `OutboxRelayGateway` and `OutboxEventRecord` are
 * declared in `.claude/skills/messaging-architect/templates/OutboxRelayPublisher.java.example`,
 * which owns the relay that consumes them. This exemplar only implements the port — one
 * interface, one owning file, the same discipline `IdempotencyKeyPort` follows. If the
 * signature here and the signature there disagree, that file wins and this one is stale.
 *
 * WHAT IT DOES NOT COVER: the write side. `OutboxAppender` — the component the outbound port's
 * implementation calls to insert the row inside the use case's transaction — stays in the
 * messaging adapter, elided in that same exemplar. It writes this entity, so it is the one
 * place outside this subpackage that needs `OutboxEventEntity` to be visible; see the
 * visibility note below. Also not here: the pruning job (a scheduled DELETE sized by
 * retention, commented at the tail of the SQL exemplar).
 *
 * PACKAGE: `…persistence.outbox` — its own subpackage, the same as `…persistence.idempotency`
 * and as any aggregate's (`.claude/rules/persistence.md` § Boundary). It is not an aggregate:
 * it is shared infrastructure, which is exactly why it must not be dumped in the persistence
 * package root. **Named as a pair with `…messaging.outbox`**, the broker half of the same
 * concern (`messaging-architect/templates/OutboxRelayPublisher.java.example`): one concern, two
 * adapters, the same subpackage name in each. A feature that split persistence per aggregate
 * and left messaging flat put four of that concern's classes in the messaging root
 * (lessons-learned-014 § 14).
 *
 * WHY THIS PORT ISN'T DECLARED IN `10-domain.md`: like `IdempotencyKeyPort`, it mirrors no
 * output port of any aggregate. `domain-modeling` declares the port that *publishes the event*;
 * this one serves the relay's own view of outbox state, and exists once for the whole project.
 *
 * TRANSACTIONS. The three marks carry `@Transactional` and nothing else does
 * (`.claude/rules/persistence.md` § Boundary): a `@Modifying` statement needs a transaction,
 * and the relay is the one caller that opens none. The claim reads and needs no transaction of
 * its own. That
 * is what the relay needs — a claim, a send, and a mark are three separate units, and holding
 * one transaction across the broker call would keep a database transaction open for the length
 * of a network round trip. The write side is the opposite case and is the whole point of Form
 * B: the appender's INSERT joins the use case's transaction, and that transaction is opened by
 * the application layer.
 *
 * SINGLE RELAY INSTANCE IS ASSUMED. The claim below does not lock rows, so two instances
 * polling at once read the same batch and send the same event twice — absorbed by the
 * idempotent consumer `.claude/rules/messaging.md` § Delivery semantics already requires, and
 * `event_id` is that dedupe key. What it must never do is lose a row, and it doesn't. When a
 * deployment does run more than one relay and the duplicate rate stops being acceptable, the
 * fix is a claim lease — a `claimed_at` column and a single `UPDATE … WHERE event_id IN
 * (SELECT … FOR UPDATE SKIP LOCKED) RETURNING …` statement, the same lease shape
 * `IdempotencyKeyStore` uses for its IN_PROGRESS rows. That is a schema change: it belongs in
 * the partial, not in a comment.
 * Which of the two shapes applies is not guessed here: `35-jobs.md` § 3 records how many
 * instances run the relay pass, and its § 6 names the claim that count requires — step 4b of
 * `SKILL.md` picks the shape that meets it and writes it as `Claim strategy`.
 *
 * RETENTION. `OutboxRetentionGateway` — declared by `jobs-architect`'s
 * `OutboxPruneJob.java.example`, called by its prune job — is implemented here too: the
 * statement is this skill's, the schedule is not.
 *
 * Each `// --- <File>.java` block is its own file.
 */

// --- outbox/OutboxEventEntity.java
package com.example.demo.adapter.out.persistence.outbox;

import com.example.demo.adapter.out.persistence.shared.AssignedIdEntity;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import java.time.Instant;
import java.util.UUID;
import lombok.AccessLevel;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.experimental.FieldDefaults;
import org.hibernate.annotations.JdbcTypeCode;
import org.hibernate.type.SqlTypes;

/**
 * Package-private, like every class in this subpackage. The one exception the write side
 * forces: `OutboxAppender` lives in the messaging adapter and constructs this entity, so
 * either it reaches the table through a narrow `public` port declared in the application
 * layer — the option that keeps this class closed, and the one to prefer — or this class and
 * its constructor become `public`, one class at a time and never the whole subpackage
 * (`.claude/rules/persistence.md` § Boundary). Whichever the partial picks, it says so: the
 * executor must not decide it by reflex.
 *
 * The no-arg constructor is {@code PROTECTED}: required by Hibernate, closed to everyone
 * else. {@code @FieldDefaults} comes from {@code lombok.experimental}, not {@code lombok}.
 *
 * No {@code @Version}. Two relays racing on the same row is handled by the send being
 * idempotent on the consumer's side, not by failing the second mark — and a false
 * optimistic-lock failure here would leave a sent row pending.
 *
 * No setter, and no mutator either: every state change a row makes after the insert is a
 * single UPDATE in the repository. A {@code markPublished(Instant)} here would be the
 * load-mutate-save shape those statements exist to replace.
 */
@Entity
@Table(name = "outbox_events")
@Getter
@NoArgsConstructor(access = AccessLevel.PROTECTED)
@FieldDefaults(level = AccessLevel.PRIVATE)
class OutboxEventEntity extends AssignedIdEntity<UUID> {

    /**
     * Assigned id, never `@GeneratedValue`: `event_id` is the event's own identity and the
     * consumer's dedupe key. Without the `isNew` flag `AssignedIdEntity` carries — shared
     * with every assigned-id entity, `JpaEntity.java.example`'s last block — Spring Data
     * calls `merge()` on the insert: a SELECT before every append, on the request path
     * (`.claude/rules/persistence.md` § Identity and keys).
     */
    @Id
    @Column(name = "event_id", nullable = false, updatable = false)
    UUID eventId;

    @Column(name = "aggregate_id", nullable = false, length = 200, updatable = false)
    String aggregateId;

    @Column(name = "event_type", nullable = false, length = 120, updatable = false)
    String eventType;

    /**
     * `jsonb` in the migration; a bare `String` infers `varchar` and `ddl-auto: validate`
     * refuses to start. The payload stays a `String` here: this adapter never parses it,
     * and mapping it to a tree would put the consumer's contract in two places.
     */
    @JdbcTypeCode(SqlTypes.JSON)
    @Column(name = "payload", nullable = false, updatable = false)
    String payload;

    @Column(name = "occurred_at", nullable = false, updatable = false)
    Instant occurredAt;

    /** Null while pending. Set once, by `markPublished`. */
    @Column(name = "published_at")
    Instant publishedAt;

    /** `smallint` in the migration; an `Integer` infers `integer`. */
    @JdbcTypeCode(SqlTypes.SMALLINT)
    @Column(name = "attempts", nullable = false)
    short attempts;

    /** No `@Lob`: on Postgres it maps a `String` to `oid`, not `text`. */
    @Column(name = "last_error")
    String lastError;

    @Column(name = "dead_lettered", nullable = false)
    boolean deadLettered;

    OutboxEventEntity(UUID eventId, String aggregateId, String eventType, String payload, Instant occurredAt) {
        this.eventId = eventId;
        this.aggregateId = aggregateId;
        this.eventType = eventType;
        this.payload = payload;
        this.occurredAt = occurredAt;
    }

    @Override
    public UUID getId() {
        return eventId;
    }
}

// --- outbox/OutboxEventJpaRepository.java
package com.example.demo.adapter.out.persistence.outbox;

import java.time.Instant;
import java.util.List;
import java.util.UUID;
import org.springframework.data.domain.Limit;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Modifying;
import org.springframework.data.jpa.repository.Query;

interface OutboxEventJpaRepository extends JpaRepository<OutboxEventEntity, UUID> {

    /**
     * The claim query. Derived, not native: the partial index
     * `ix_outbox_events_pending (occurred_at) WHERE published_at IS NULL AND NOT dead_lettered`
     * serves it exactly, and `Limit` keeps the batch bound out of the method name.
     * `ORDER BY occurred_at` is what preserves per-aggregate order: two events of one
     * aggregate go to the same partition in the order they occurred
     * (`.claude/rules/messaging.md` § Delivery semantics).
     */
    List<OutboxEventEntity> findByPublishedAtIsNullAndDeadLetteredIsFalseOrderByOccurredAtAsc(Limit limit);

    /**
     * The marks, as single statements. Loading the row and saving it back costs two
     * round-trips per event in two separate transactions, with the entity detached in
     * between: a batch of 100 pays ~201 where ~101 does the same work
     * (lessons-learned-013 § 8.2). Nothing here needs the entity — each mark is a set of
     * columns and a predicate, which is exactly what an UPDATE is.
     *
     * `clearAutomatically` is deliberately absent: this adapter never loads the entity it
     * updates, so there is no stale copy in the persistence context to evict.
     */
    @Modifying
    @Query("""
            update OutboxEventEntity e
               set e.publishedAt = :now, e.lastError = null
             where e.eventId = :eventId""")
    int markPublished(UUID eventId, Instant now);

    /**
     * Dead-lettering by exhaustion, attempted FIRST so its row count is the answer to "did
     * this attempt exhaust the row": 1 means it did. Zero means the row has attempts left and
     * `recordAttempt` below records one. Two statements in the failure path, one in the
     * success path — the hot path is the one that succeeds.
     */
    @Modifying
    @Query("""
            update OutboxEventEntity e
               set e.attempts = e.attempts + 1, e.lastError = :reason, e.deadLettered = true
             where e.eventId = :eventId
               and e.deadLettered = false
               and e.attempts + 1 >= :maxAttempts""")
    int deadLetterIfExhausted(UUID eventId, String reason, int maxAttempts);

    @Modifying
    @Query("""
            update OutboxEventEntity e
               set e.attempts = e.attempts + 1, e.lastError = :reason
             where e.eventId = :eventId
               and e.deadLettered = false""")
    int recordAttempt(UUID eventId, String reason);

    /** Dead-lettering by decision, not by exhaustion: an event type no topic maps. */
    @Modifying
    @Query("""
            update OutboxEventEntity e
               set e.deadLettered = true, e.lastError = :reason
             where e.eventId = :eventId""")
    int markDeadLettered(UUID eventId, String reason);

    /**
     * Feeds the relay's pending-age gauge. A scalar `min`, served by the same partial index as
     * the claim query, so a scrape costs an index lookup and not a row.
     */
    @Query("""
            select min(e.occurredAt) from OutboxEventEntity e
             where e.publishedAt is null and e.deadLettered = false""")
    Instant oldestPendingOccurredAt();

    /**
     * The prune's statement — bounded, published rows only. Native, because JPQL has no
     * `LIMIT` on a `DELETE`; the subquery is served by `ix_outbox_events_published_at`. Never
     * on the relay path. A dead-lettered row is never pruned — it has no `published_at`, and it
     * is the record of an event that was produced and never delivered.
     */
    @Modifying
    @Query(nativeQuery = true, value = """
            delete from outbox_events
             where event_id in (select event_id from outbox_events
                                 where published_at < :cutoff
                                 order by published_at
                                 limit :limit)""")
    int deletePublishedBefore(Instant cutoff, int limit);
}

// --- outbox/OutboxEventStore.java
package com.example.demo.adapter.out.persistence.outbox;

import com.example.demo.application.port.out.OutboxEventRecord;
import com.example.demo.application.port.out.OutboxRelayGateway;
import com.example.demo.application.port.out.OutboxRetentionGateway;
import java.time.Clock;
import java.time.Instant;
import java.util.List;
import java.util.Optional;
import java.util.UUID;
import lombok.AccessLevel;
import lombok.RequiredArgsConstructor;
import lombok.experimental.FieldDefaults;
import org.springframework.data.domain.Limit;
import org.springframework.stereotype.Component;
import org.springframework.transaction.annotation.Transactional;

@Component
@RequiredArgsConstructor(access = AccessLevel.PACKAGE)
@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
class OutboxEventStore implements OutboxRelayGateway, OutboxRetentionGateway {

    /**
     * `last_error` is `text`, so nothing truncates for us. A stack trace in every row turns
     * the outbox into a log table.
     */
    private static final int MAX_ERROR_LENGTH = 500;

    OutboxEventJpaRepository repository;
    /**
     * Injected, never `Instant.now()` — `.claude/rules/architecture-ddd.md` § Domain, and the
     * reason this adapter can be tested without waiting for a clock. The port's signature
     * carries no timestamp, so the stamp is this adapter's to produce.
     */
    Clock clock;

    @Override
    public List<OutboxEventRecord> claimPending(int batchSize) {
        return repository
                .findByPublishedAtIsNullAndDeadLetteredIsFalseOrderByOccurredAtAsc(Limit.of(batchSize))
                .stream()
                .map(OutboxEventStore::toRecord)
                .toList();
    }

    /**
     * `@Transactional` on the three marks, and ONLY on them: a `@Modifying` statement needs a
     * transaction of its own, and this is the one place in this adapter that writes without
     * the caller providing one — the relay's claim, send and mark are three separate units by
     * design (see the TRANSACTIONS note at the head of this file). The use-case path is
     * untouched: the appender's INSERT still joins the transaction the application layer
     * opened.
     */
    @Override
    @Transactional
    public void markPublished(UUID eventId) {
        repository.markPublished(eventId, clock.instant());
    }

    @Override
    @Transactional
    public boolean markFailed(UUID eventId, String reason, int maxAttempts) {
        String message = truncate(reason);
        if (repository.deadLetterIfExhausted(eventId, message, maxAttempts) == 1) {
            return true;
        }
        repository.recordAttempt(eventId, message);
        return false;
    }

    @Override
    @Transactional
    public void markDeadLettered(UUID eventId, String reason) {
        repository.markDeadLettered(eventId, truncate(reason));
    }

    @Override
    public Optional<Instant> oldestPendingOccurredAt() {
        return Optional.ofNullable(repository.oldestPendingOccurredAt());
    }

    /**
     * One bounded batch per call, in its own transaction: the prune's service loops, and a
     * failure halfway keeps every batch already deleted.
     */
    @Override
    @Transactional
    public int deletePublishedBefore(Instant cutoff, int limit) {
        return repository.deletePublishedBefore(cutoff, limit);
    }

    /**
     * The port's type, not the entity: nothing outside this subpackage sees a JPA class
     * (`.claude/rules/persistence.md` § Boundary). One carrier serves both directions — the
     * appender writes it, the relay reads it; a second record with the same components is the
     * same type written twice (lessons-learned-013 § 8.3).
     */
    private static OutboxEventRecord toRecord(OutboxEventEntity event) {
        return new OutboxEventRecord(
                event.getEventId(),
                event.getAggregateId(),
                event.getEventType(),
                event.getPayload(),
                event.getOccurredAt());
    }

    private static String truncate(String reason) {
        if (reason == null) {
            return "unknown";
        }
        return reason.length() <= MAX_ERROR_LENGTH ? reason : reason.substring(0, MAX_ERROR_LENGTH);
    }
}
