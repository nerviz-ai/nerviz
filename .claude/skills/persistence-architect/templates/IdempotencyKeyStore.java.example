/*
 * EXEMPLAR — persistence side of `Idempotency-Key`. Form reference for the executor
 * agent; not a file to copy verbatim.
 * Rules: `.claude/rules/api-rest.md` (§ Idempotency) · `.claude/rules/persistence.md`
 *        (§ Boundary, § Mapping, § Identity and keys) · `.claude/rules/error-handling.md`
 *        (typed family) · `.claude/rules/lombok.md` (`@Data` and `@Setter` forbidden)
 *
 * PACKAGE: `…persistence.idempotency` — its own subpackage, the same as any aggregate's
 * (`.claude/rules/persistence.md` § Boundary). It isn't an aggregate, it's shared
 * infrastructure, and that is exactly why it must not be dumped into the persistence
 * package root: a root that holds "whatever belongs to nobody" is the flat package the
 * rule exists to prevent. What crosses to other aggregates is the port
 * `IdempotencyKeyPort`, declared in the application layer — nothing here becomes
 * `public` for that.
 *
 * WHY THIS PORT ISN'T DECLARED IN `10-domain.md`: every other port in this module
 * mirrors an output port `domain-modeling` wrote for one aggregate. This one doesn't —
 * it's shared infrastructure, the transactional mirror of `rest-api-architect`'s
 * `IdempotencyKeyInterceptor` (which only checks header shape). Model it once, the
 * first time some use case's `30-rest.md` requires `Idempotency-Key`; every use case
 * after that reuses the same table and the same port, never redeclares it.
 *
 * TRANSACTION SHAPE (`.claude/rules/api-rest.md` § Idempotency). Two transactions, never
 * one and never three:
 *
 *   1. `claim` — commits on its own, BEFORE the business effect. It must run with no
 *      transaction active: it catches the primary-key violation and then reads the
 *      winner's row, and on Postgres a transaction that hit a constraint violation is
 *      aborted ("current transaction is aborted, commands ignored until end of
 *      transaction block"). Each repository call here is its own transaction.
 *   2. business effect + `complete` — one transaction, opened by the application layer
 *      (`templates/IdempotentExecution.java.example`). The effect and the stored response
 *      commit together or not at all.
 *
 * `release` runs when step 2 rolled back: the key is freed, so a retry executes again
 * instead of hitting 409. The one gap left is a process crash between 1 and 2 — the row
 * stays IN_PROGRESS, retries get 409 + `Retry-After`, and the first retry after
 * `IN_PROGRESS_LEASE` reclaims it. That window is accepted by the rule, not accidental.
 *
 * Each `// --- <File>.java` block is its own file.
 */

// --- IdempotencyKeyPort.java
package com.example.demo.application.port.out;

import java.util.UUID;

/**
 * One instance for the whole application, not one per aggregate — see the exemplar's
 * header comment for why this port has no domain-modeling counterpart.
 */
public interface IdempotencyKeyPort {

    /** Commits on its own. Called with no transaction active. */
    IdempotencyClaim claim(IdempotencyRequest request);

    /** Joins the caller's transaction — the same one as the business effect. */
    void complete(UUID key, StoredResponse response);

    /** Commits on its own. Called after the business transaction rolled back. */
    void release(UUID key);
}

// --- IdempotencyRequest.java
package com.example.demo.application.port.out;

import java.time.Instant;
import java.util.UUID;

/**
 * Transport-agnostic: the adapter computes `route`, `callerIdentity`, and `bodyHash`
 * from the request; the application never sees HTTP types
 * (`.claude/rules/architecture-ddd.md` § Application). A parameter object, not five
 * positional arguments (`.claude/rules/code-quality.md`, ≤ 3 parameters).
 */
public record IdempotencyRequest(UUID key, String route, String callerIdentity, String bodyHash, Instant now) {}

// --- StoredResponse.java
package com.example.demo.application.port.out;

/**
 * What a replay hands back verbatim. Status, serialized body, and serialized response
 * headers (JSON-encoded `Map<String, List<String>>`), produced by the adapter — the
 * application stores all three without knowing they're HTTP or JSON. `headers` matters
 * once a replay is rebuilt generically (`rest-api-architect`'s
 * `IdempotencyAspect.java.example`), not for an endpoint that reconstructs its own
 * headers by hand on replay (`Controller.java.example`'s `Location`) — that caller can
 * pass `"{}"`.
 */
public record StoredResponse(int status, String body, String headers) {}

// --- IdempotencyClaim.java
package com.example.demo.application.port.out;

/**
 * Proceed: this request holds the key — run the effect, then `complete`.
 * Replay: a prior request with the same key AND the same body already finished —
 * return its response verbatim, the effect does not run again.
 */
public sealed interface IdempotencyClaim {
    record Proceed() implements IdempotencyClaim {}
    record Replay(StoredResponse response) implements IdempotencyClaim {}
}

// --- idempotency/IdempotencyKeyEntity.java
package com.example.demo.adapter.out.persistence.idempotency;

import com.example.demo.adapter.out.persistence.shared.AssignedIdEntity;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.EnumType;
import jakarta.persistence.Enumerated;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import jakarta.persistence.Version;
import java.time.Instant;
import java.util.UUID;
import lombok.AccessLevel;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.experimental.FieldDefaults;
import org.hibernate.annotations.JdbcTypeCode;
import org.hibernate.type.SqlTypes;

/**
 * Persistable is not optional here: the id is the client's key, never
 * {@code @GeneratedValue}, and the version is primitive. Without the {@code isNew} flag
 * {@code AssignedIdEntity} carries — shared with every assigned-id entity — Spring Data calls
 * {@code merge()}: SELECT, then UPDATE if the row exists, and the primary-key collision
 * {@code claim} depends on never fires (`.claude/rules/persistence.md` § Identity and keys).
 * The no-arg constructor is {@code PROTECTED}: required by Hibernate, closed to everyone
 * else. {@code @FieldDefaults} comes from {@code lombok.experimental}, not {@code lombok}.
 */
@Entity
@Table(name = "idempotency_keys")
@Getter
@NoArgsConstructor(access = AccessLevel.PROTECTED)
@FieldDefaults(level = AccessLevel.PRIVATE)
class IdempotencyKeyEntity extends AssignedIdEntity<UUID> {

    /**
     * The key IS the primary key — global uniqueness is exactly the guarantee wanted,
     * and it's what makes the racing INSERT in `IdempotencyKeyStore.claim` the
     * concurrency control. No surrogate id.
     */
    @Id
    @Column(name = "idempotency_key", nullable = false, updatable = false)
    UUID idempotencyKey;

    @Column(name = "route", nullable = false, length = 200, updatable = false)
    String route;

    @Column(name = "caller_identity", nullable = false, length = 200, updatable = false)
    String callerIdentity;

    /**
     * `char(64)` in the migration; a `String` infers `varchar` and `ddl-auto: validate`
     * refuses to start.
     */
    @JdbcTypeCode(SqlTypes.CHAR)
    @Column(name = "body_hash", nullable = false, length = 64, updatable = false)
    String bodyHash;

    /** STRING, never ORDINAL: reordering the enum would corrupt stored rows. */
    @Enumerated(EnumType.STRING)
    @Column(name = "status", nullable = false, length = 20)
    IdempotencyStatus status;

    /** `smallint` in the migration; an `Integer` infers `integer`. */
    @JdbcTypeCode(SqlTypes.SMALLINT)
    @Column(name = "response_status")
    Integer responseStatus;

    /**
     * No `@Lob`: on Postgres it maps a `String` to `oid`, not `text`. A bare `String`
     * already maps to `text`.
     */
    @Column(name = "response_body")
    String responseBody;

    /**
     * JSON-encoded `Map<String, List<String>>` — nullable, additive column. Needed to
     * replay a header a generic caller can't hand-reconstruct (e.g. `Location`); see
     * `StoredResponse`.
     */
    @Column(name = "response_headers")
    String responseHeaders;

    @Column(name = "claimed_at", nullable = false)
    Instant claimedAt;

    @Column(name = "created_at", nullable = false, updatable = false)
    Instant createdAt;

    @Column(name = "expires_at", nullable = false, updatable = false)
    Instant expiresAt;

    /**
     * Two requests reclaiming the same stale lease: one UPDATE matches the version, the
     * other gets an optimistic-lock failure and answers 409 in-progress.
     */
    @Version
    @Column(name = "version", nullable = false)
    long version;

    IdempotencyKeyEntity(IdempotencyRequest request, Instant expiresAt) {
        this.idempotencyKey = request.key();
        this.route = request.route();
        this.callerIdentity = request.callerIdentity();
        this.bodyHash = request.bodyHash();
        this.status = IdempotencyStatus.IN_PROGRESS;
        this.claimedAt = request.now();
        this.createdAt = request.now();
        this.expiresAt = expiresAt;
    }

    /**
     * No setter. The state changes this row makes: IN_PROGRESS -> COMPLETED, and a stale
     * IN_PROGRESS lease taken over by a new request.
     */
    void applyResponse(int responseStatus, String responseBody, String responseHeaders) {
        this.status = IdempotencyStatus.COMPLETED;
        this.responseStatus = responseStatus;
        this.responseBody = responseBody;
        this.responseHeaders = responseHeaders;
    }

    void reclaim(Instant now) {
        this.claimedAt = now;
    }

    @Override
    public UUID getId() {
        return idempotencyKey;
    }
}

// --- idempotency/IdempotencyStatus.java
package com.example.demo.adapter.out.persistence.idempotency;

enum IdempotencyStatus { IN_PROGRESS, COMPLETED }

// --- idempotency/IdempotencyKeyJpaRepository.java
package com.example.demo.adapter.out.persistence.idempotency;

import java.time.Instant;
import java.util.List;
import java.util.UUID;
import org.springframework.data.jpa.repository.JpaRepository;

interface IdempotencyKeyJpaRepository extends JpaRepository<IdempotencyKeyEntity, UUID> {

    /**
     * Read by the cleanup job (`templates/IdempotencyKeyTable.sql.example`'s commented
     * DELETE, or a scheduled equivalent). Not called on the request path.
     */
    List<IdempotencyKeyEntity> findByExpiresAtBefore(Instant cutoff);
}

// --- idempotency/IdempotencyKeyStore.java
package com.example.demo.adapter.out.persistence.idempotency;

import com.example.demo.application.port.out.IdempotencyClaim;
import com.example.demo.application.port.out.IdempotencyKeyPort;
import com.example.demo.application.port.out.IdempotencyRequest;
import com.example.demo.application.port.out.StoredResponse;
import com.example.demo.domain.exception.ConflictException;
import java.time.Duration;
import java.util.UUID;
import org.springframework.dao.DataIntegrityViolationException;
import org.springframework.dao.OptimisticLockingFailureException;
import org.springframework.stereotype.Component;
import org.springframework.transaction.support.TransactionSynchronizationManager;

@Component
class IdempotencyKeyStore implements IdempotencyKeyPort {

    /** Floor set by `.claude/rules/api-rest.md` § Idempotency. */
    private static final Duration TTL = Duration.ofHours(24);

    /**
     * Longer than the slowest request this key protects. Past it, an IN_PROGRESS row is a
     * crashed request, not a slow one.
     */
    private static final Duration IN_PROGRESS_LEASE = Duration.ofMinutes(5);

    private final IdempotencyKeyJpaRepository repository;

    IdempotencyKeyStore(IdempotencyKeyJpaRepository repository) {
        this.repository = repository;
    }

    /**
     * saveAndFlush, not save: the INSERT has to reach the database now, inside
     * this try, for the primary-key violation to surface here.
     *
     * The INSERT's transaction already rolled back; this read is a new one.
     */
    @Override
    public IdempotencyClaim claim(IdempotencyRequest request) {
        requireNoTransaction("claim");
        try {
            repository.saveAndFlush(new IdempotencyKeyEntity(request, request.now().plus(TTL)));
            return new IdempotencyClaim.Proceed();
        } catch (DataIntegrityViolationException cause) {
            IdempotencyKeyEntity existing = repository.findById(request.key()).orElseThrow(() -> cause);
            return resolveCollision(existing, request);
        }
    }

    /**
     * Managed entity: dirty checking writes it at the business transaction's commit.
     */
    @Override
    public void complete(UUID key, StoredResponse response) {
        if (!TransactionSynchronizationManager.isActualTransactionActive()) {
            throw new IllegalStateException("complete must join the business transaction");
        }
        repository.findById(key).orElseThrow()
                .applyResponse(response.status(), response.body(), response.headers());
    }

    @Override
    public void release(UUID key) {
        requireNoTransaction("release");
        repository.deleteById(key);
    }

    private IdempotencyClaim resolveCollision(IdempotencyKeyEntity existing, IdempotencyRequest request) {
        if (!existing.getBodyHash().equals(request.bodyHash())) {
            throw new ConflictException("IDEMPOTENCY_KEY_REUSED",
                    "Idempotency-Key " + request.key() + " was already used with a different request body");
        }
        if (existing.getStatus() == IdempotencyStatus.COMPLETED) {
            return new IdempotencyClaim.Replay(new StoredResponse(
                    existing.getResponseStatus(), existing.getResponseBody(), existing.getResponseHeaders()));
        }
        if (existing.getClaimedAt().plus(IN_PROGRESS_LEASE).isAfter(request.now())) {
            throw inProgress(request.key());
        }
        return reclaim(existing, request);
    }

    /**
     * {@code saveAndFlush} issues {@code UPDATE ... WHERE version = ?}: the loser of a race
     * gets the optimistic-lock failure.
     */
    private IdempotencyClaim reclaim(IdempotencyKeyEntity stale, IdempotencyRequest request) {
        stale.reclaim(request.now());
        try {
            repository.saveAndFlush(stale);
            return new IdempotencyClaim.Proceed();
        } catch (OptimisticLockingFailureException lostRace) {
            throw inProgress(request.key());
        }
    }

    /**
     * 409 here; the advice attaches Retry-After — that header is a transport concern,
     * not this adapter's.
     */
    private static ConflictException inProgress(UUID key) {
        return new ConflictException("IDEMPOTENCY_KEY_IN_PROGRESS",
                "Request with Idempotency-Key " + key + " is still being processed");
    }

    private static void requireNoTransaction(String operation) {
        if (TransactionSynchronizationManager.isActualTransactionActive()) {
            throw new IllegalStateException(operation + " must commit on its own, outside the business transaction");
        }
    }
}
