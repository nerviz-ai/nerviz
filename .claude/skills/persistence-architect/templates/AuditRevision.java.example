/*
 * EXEMPLAR — the one revision entity of a project with a `history`, and the listener that
 * records who made each revision. Form reference for the executor agent.
 * Rules: `.claude/rules/persistence.md` (§ Auditing · Relational — Envers)
 *
 * ONE PER PROJECT: Envers accepts a single `@RevisionEntity`. A revision is one transaction:
 * every audited row it touched points at it, so the actor lives here, once, and a delete
 * revision — whose `_aud` row keeps only the id — still says who deleted.
 *
 * THE TYPES, AND WHY:
 *   - the number is a `Long`: an `int` overflows into an `AuditException` that rolls back the
 *     business write;
 *   - the timestamp is a `long` (epoch milliseconds), never an `Instant`: the validity strategy
 *     with the revision-end timestamp casts it to `Long`, and an `Instant` fails the commit of
 *     every update with a `ClassCastException` — observed (decision 0149). The accessor turns it
 *     into an `Instant`;
 *   - the sequence's `allocationSize` equals the migration's `INCREMENT BY`; `ddl-auto: validate`
 *     refuses to start otherwise.
 *
 * THE LISTENER IS A SPRING BEAN: Spring Boot hands Hibernate a bean container, so Envers gets
 * the listener with its constructor dependency — observed (decision 0149).
 *
 * Each `// --- <File>.java` block is its own file.
 */

// --- shared/audit/AuditRevision.java
package com.example.demo.adapter.out.persistence.shared.audit;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.SequenceGenerator;
import jakarta.persistence.Table;
import java.time.Instant;
import lombok.AccessLevel;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.experimental.FieldDefaults;
import org.hibernate.envers.RevisionEntity;
import org.hibernate.envers.RevisionNumber;
import org.hibernate.envers.RevisionTimestamp;

/** {@code public}: a history adapter in an aggregate's subpackage reads its actor. */
@Entity
@Table(name = "revinfo")
@RevisionEntity(AuditRevisionListener.class)
@NoArgsConstructor(access = AccessLevel.PROTECTED)
@FieldDefaults(level = AccessLevel.PRIVATE)
public class AuditRevision {

    @Getter
    @Id
    @GeneratedValue(strategy = GenerationType.SEQUENCE, generator = "revinfo_seq")
    @SequenceGenerator(name = "revinfo_seq", sequenceName = "revinfo_seq", allocationSize = 50)
    @RevisionNumber
    @Column(name = "rev")
    Long id;

    @RevisionTimestamp
    @Column(name = "revtstmp", nullable = false)
    long timestamp;

    @Getter
    @Column(name = "actor", nullable = false, length = 100)
    String actor;

    public Instant instant() {
        return Instant.ofEpochMilli(timestamp);
    }

    void recordActor(String newActor) {
        this.actor = newActor;
    }
}

// --- shared/audit/AuditRevisionListener.java
package com.example.demo.adapter.out.persistence.shared.audit;

import org.hibernate.envers.RevisionListener;
import org.springframework.stereotype.Component;

/** Called once per revision, inside the transaction that writes it. */
@Component
class AuditRevisionListener implements RevisionListener {

    private final AuditorResolver auditorResolver;

    AuditRevisionListener(AuditorResolver auditorResolver) {
        this.auditorResolver = auditorResolver;
    }

    @Override
    public void newRevision(Object revisionEntity) {
        ((AuditRevision) revisionEntity).recordActor(auditorResolver.currentAuditor());
    }
}
