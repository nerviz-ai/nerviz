/*
 * EXEMPLAR — persistence entity. Lives in the output adapter, never in the domain.
 * Form reference for the executor agent; not a file to copy verbatim.
 * Rules: `.claude/rules/persistence.md` (§ Boundary, § Mapping, § Identity)
 *        `.claude/rules/lombok.md` (`@Data` and `@Setter` forbidden)
 *        `.claude/rules/architecture-ddd.md` (adapter has no business logic)
 *
 * WHY IT ISN'T A RECORD: Hibernate requires a no-arg constructor and fields mutable by
 * reflection. That's why this class exists separate from the aggregate, which is
 * immutable. Two classes, two owners, one explicit translation between them.
 *
 * WHY `Persistable`: the id is assigned by the application, never `@GeneratedValue`.
 * Spring Data decides persist-vs-merge by a null id or a null wrapper `@Version`; a
 * primitive `long` version counts as absent. Here the id is never null, so without
 * `isNew` every `save()` of a new user becomes `merge()`: a wasted `SELECT` before the
 * `INSERT`, and no primary-key collision ever raised
 * (`.claude/rules/persistence.md` § Identity and keys).
 *
 * WHY A BASE CLASS: the `isNew` flag and its two callbacks are the same 14 lines in every
 * entity with an assigned id — Sonar reported them as the project's duplicated block. They
 * live once, in `AssignedIdEntity` (last block below); the entity extends it and implements
 * only `getId()`. Create it the first time an assigned-id entity is written, and reuse it
 * afterwards: the outbox and idempotency entities extend the same class.
 *
 * WHY `equals` AND `hashCode` ARE NOT HERE: the rule forbids basing them on a
 * database-generated id — while the entity is transient the id is null and the contract
 * breaks inside a `Set`. If they're really needed, base them on the business key
 * (`email`), not the PK.
 *
 * PACKAGE: the aggregate's own subpackage, `…persistence.user` — one per aggregate,
 * never a flat `…persistence` (`.claude/rules/persistence.md` § Boundary). The
 * persistence-side enum below belongs to the same aggregate, so it goes in the same
 * subpackage.
 *
 * Each `// --- <File>.java` block is its own file.
 */

// --- user/UserEntity.java
package com.example.demo.adapter.out.persistence.user;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.EnumType;
import jakarta.persistence.Enumerated;
import com.example.demo.adapter.out.persistence.shared.AssignedIdEntity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import jakarta.persistence.Version;
import java.time.Instant;
import java.util.UUID;
import lombok.AccessLevel;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.experimental.FieldDefaults;

/**
 * The no-arg constructor is {@code PROTECTED}: required by Hibernate, closed to everyone
 * else. All fields are private, so the modifier is declared once, with
 * {@code @FieldDefaults} from {@code lombok.experimental}, not {@code lombok}
 * (`.claude/rules/lombok.md` § @FieldDefaults). No {@code makeFinal}: Hibernate writes the
 * fields by reflection and needs them mutable — the exception the rule allows for.
 */
@Entity
@Table(name = "users")
@Getter
@NoArgsConstructor(access = AccessLevel.PROTECTED)
@FieldDefaults(level = AccessLevel.PRIVATE)
class UserEntity extends AssignedIdEntity<UUID> {

    /**
     * Id assigned by the application: the aggregate is already born with a `UserId`, so
     * there's no "half-created" state waiting for a database id. Where the id comes
     * from the database, prefer `GenerationType.SEQUENCE` — `IDENTITY` disables insert
     * batching.
     */
    @Id
    @Column(name = "id", nullable = false, updatable = false)
    UUID id;

    @Column(name = "email", nullable = false, length = 254, unique = true)
    String email;

    @Column(name = "name", nullable = false, length = 120)
    String name;

    /**
     * Absence modeled as null in the column. The mapper translates to the domain's Null
     * Object (`DepartmentId.unassigned()`) — the domain never sees null.
     */
    @Column(name = "department_id")
    UUID departmentId;

    /** STRING, never ORDINAL: reordering the enum would corrupt already-stored rows. */
    @Enumerated(EnumType.STRING)
    @Column(name = "status", nullable = false, length = 20)
    UserStatus status;

    @Column(name = "created_at", nullable = false, updatable = false)
    Instant createdAt;

    /**
     * Optimistic locking. Invisible to the domain: the adapter translates the failure
     * into the conflict exception from `.claude/rules/error-handling.md`.
     */
    @Version
    @Column(name = "version", nullable = false)
    long version;

    UserEntity(UUID id, String email, String name, UUID departmentId,
               UserStatus status, Instant createdAt) {
        this.id = id;
        this.email = email;
        this.name = name;
        this.departmentId = departmentId;
        this.status = status;
        this.createdAt = createdAt;
    }

    /**
     * No setters. The entity changes through methods that say what changed — and even
     * these decide nothing: the rule was already applied on the aggregate before it got
     * here.
     */
    void applyName(String newName) {
        this.name = newName;
    }

    void applyDepartment(UUID newDepartmentId) {
        this.departmentId = newDepartmentId;
    }

    @Override
    public UUID getId() {
        return id;
    }
}

// --- user/UserStatus.java
package com.example.demo.adapter.out.persistence.user;

/** Persistence-side enum. Mirrors the domain's; not the same type. */
enum UserStatus { ACTIVE, SUSPENDED, CLOSED }

// --- shared/AssignedIdEntity.java
package com.example.demo.adapter.out.persistence.shared;

import jakarta.persistence.MappedSuperclass;
import jakarta.persistence.PostLoad;
import jakarta.persistence.PostPersist;
import jakarta.persistence.Transient;
import lombok.AccessLevel;
import lombok.experimental.FieldDefaults;
import org.springframework.data.domain.Persistable;

/**
 * The `Persistable` mechanics every assigned-id entity needs, once per project. Not an
 * aggregate's class, so it lives in `…persistence.shared`, and it is `public` because every
 * aggregate subpackage extends it — the one consumer the visibility default allows for
 * (`.claude/rules/persistence.md` § Boundary). No Lombok and no fields beyond the flag: an
 * id, a version or an audit column here would couple every table to one shape.
 *
 * JPA applies callbacks declared on a `@MappedSuperclass` to every subclass, so `@PostLoad`
 * and `@PostPersist` below flip the flag for each entity that extends it. The ArchUnit
 * guard for assigned ids checks `implement(Persistable)`, which is transitive: extending
 * this class satisfies it.
 */
@MappedSuperclass
@FieldDefaults(level = AccessLevel.PRIVATE)
public abstract class AssignedIdEntity<T> implements Persistable<T> {

    /**
     * Not a column. True only for an instance built by a constructor; loaded or
     * already-persisted instances flip it, so an update still goes through `merge()`.
     */
    @Transient
    boolean isNew = true;

    @Override
    public boolean isNew() {
        return isNew;
    }

    @PostLoad
    @PostPersist
    void markNotNew() {
        isNew = false;
    }
}
