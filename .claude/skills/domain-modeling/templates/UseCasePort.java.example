/*
 * EXEMPLAR — a use case's ports: input, output, and the implementation that ties them
 * together.
 * Form reference for the executor agent; not a file to copy verbatim.
 * Rules: `.claude/rules/architecture-ddd.md` (one input abstraction per use case,
 *          the transaction opens and closes in the application layer, no HTTP/JPA
 *          types in signatures)
 *        `.claude/rules/naming.md` (§ Architecture vocabulary — this exemplar is hexagonal:
 *          `<Verb><Noun>UseCase` port + `…Service`; clean architecture has a concrete
 *          `<Verb><Noun>UseCase` and no port; never an Impl suffix)
 *        `.claude/rules/lombok.md` (§ Generated boilerplate — the service's constructor is
 *          `@RequiredArgsConstructor` over its final fields)
 *
 * WHAT THIS EXEMPLAR SHOWS:
 *  - an input port with **one** method. A fat interface is a smell: two methods here
 *    are almost always two use cases;
 *  - an output port declared in the application layer and implemented in the adapter —
 *    the dependency points inward;
 *  - `@Transactional` in the implementation, which belongs to the application layer. In
 *    the domain it would be framework crossing the boundary; in the adapter, the
 *    transaction would open too late.
 *
 * THE SPRING ANNOTATION IN THIS FILE IS DELIBERATE: `architecture-ddd.md` puts
 * composition and configuration in the application layer and the bootstrap, not the
 * domain. `Email`, `User`, and the events import nothing from `org.springframework` —
 * these are the ones that can.
 */

// --- CreateUserUseCase.java
package com.example.demo.application.port.in.user;

import com.example.demo.domain.model.UserId;

public interface CreateUserUseCase {

    /**
     * @throws com.example.demo.domain.exception.ValidationException malformed data
     * @throws com.example.demo.domain.exception.ConflictException email already registered
     */
    UserId create(CreateUserCommand command);
}

// --- UserRepository.java
package com.example.demo.application.port.out;

import com.example.demo.domain.model.Email;
import com.example.demo.domain.model.User;

public interface UserRepository {

    boolean existsByEmail(Email email);

    User save(User user);
}

// --- CreateUserService.java
package com.example.demo.application.service.user;

import com.example.demo.application.port.in.user.CreateUserCommand;
import com.example.demo.application.port.in.user.CreateUserUseCase;
import com.example.demo.application.port.out.UserRepository;
import com.example.demo.domain.exception.ConflictException;
import com.example.demo.domain.model.DepartmentId;
import com.example.demo.domain.model.Email;
import com.example.demo.domain.model.User;
import com.example.demo.domain.model.UserId;
import java.time.Clock;
import lombok.AccessLevel;
import lombok.RequiredArgsConstructor;
import lombok.experimental.FieldDefaults;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

@Service
@RequiredArgsConstructor
@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
public class CreateUserService implements CreateUserUseCase {

    UserRepository userRepository;
    Clock clock;

    @Override
    @Transactional
    public UserId create(CreateUserCommand command) {
        Email email = Email.of(command.email());
        if (userRepository.existsByEmail(email)) {
            throw new ConflictException("EMAIL_ALREADY_USED", "email already registered");
        }
        DepartmentId departmentId = command.departmentId() == null
                ? DepartmentId.unassigned()
                : DepartmentId.of(command.departmentId());
        User user = User.register(email, command.name(), departmentId, clock);
        return userRepository.save(user).id();
    }
}
