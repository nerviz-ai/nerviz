# EXEMPLAR — search engine connection. Form reference, not a file to copy.
# Rules: `.claude/rules/search.md` (§ Configuration) · `.claude/rules/secrets.md`
#
# ONE ENGINE PER PROJECT — the Elasticsearch block or the OpenSearch block, never both. The adapter
# code is the same for both engines; the dependency (the partial's § Declared dependencies) and
# these properties are not. The Elasticsearch client speaks to Elasticsearch only, and its major
# must match the server's.
#
# LOCAL RUNS OVER HTTP, WITH A PASSWORD. The compose service (docker-architect's
# `elasticsearch-service.yml.example` / `opensearch-service.yml.example`) keeps authentication on
# and HTTP TLS off, so the host run needs no certificate. Production serves TLS: SEARCH_URIS is
# `https://…` there and the SSL bundle below — active outside `local`, `docker` and `test`, the same
# expression transport-security uses — trusts its CA. Tests get theirs from the container.
#
# Values marked RULE are mandatory; SIZE values are the partial's, with the reason next to them.
# Same variable names as the compose service. The password has no default.

# --- Elasticsearch (spring-boot-starter-data-elasticsearch, version managed by Spring Boot)
spring:
  elasticsearch:
    uris: ${SEARCH_URIS:http://localhost:${SEARCH_PORT:9200}}
    username: ${SEARCH_USERNAME:elastic}
    password: ${SEARCH_PASSWORD}
    connection-timeout: 2s           # SIZE — RULE to set it
    socket-timeout: 5s               # SIZE — RULE to set it; a search slower than this is a failure, not a wait

app:
  search:
    replicas: ${SEARCH_REPLICAS:0}   # SIZE — 0 on a single node, which never turns green with 1

---
spring:
  config:
    activate:
      on-profile: "!local & !docker & !test"
  elasticsearch:
    restclient:
      ssl:
        bundle: search               # RULE wherever the engine serves TLS
  ssl:
    bundle:
      pem:
        search:
          truststore:
            certificate: ${SEARCH_CA_CERT}

# --- OpenSearch, in place of the Elasticsearch block above
#     (org.opensearch.client:spring-data-opensearch-starter + opensearch-java, versions resolved
#     from Maven Central by the compatibility matrix; Spring Boot manages neither)
#
# opensearch:
#   uris: ${SEARCH_URIS:http://localhost:${SEARCH_PORT:9200}}
#   username: ${SEARCH_USERNAME:admin}
#   password: ${SEARCH_PASSWORD}
#   connection-timeout: 2s           # SIZE — RULE to set it
#   socket-timeout: 5s               # SIZE — RULE to set it
