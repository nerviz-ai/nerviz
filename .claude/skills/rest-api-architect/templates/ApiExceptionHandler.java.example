/*
 * EXEMPLAR — @RestControllerAdvice that translates the typed family from
 * `.claude/rules/error-handling.md` into `ProblemDetail` (RFC 7807), native to Spring
 * Boot 4 (no custom error DTO). Lives in the module with `feature: rest`
 * (`adapter-in-rest` in the hexagonal blueprint), never in the domain — it's here, and
 * only here, that a business exception becomes an HTTP response.
 * Compilable as-is — not pseudo-code.
 *
 * Three extension fields, and no others (`.claude/rules/api-rest.md` § Error body):
 *   errorCode  — every error coming from the domain, and an admission rejection
 *   traceId    — every 5xx, the same identifier that went into the log
 *   violations — bean validation in the adapter, and never with errorCode
 *
 * TWO VARIANTS, and the choice isn't the executor's: it's the blueprint's
 * `feature: observability` that fixes it, and `.claude/rules/observability.md` §
 * Correlation that requires writing it in a comment. Confirm with
 * `./mvnw dependency:tree | grep micrometer-tracing` before choosing.
 *
 *   feature active → this variant. traceId source: Micrometer Tracing (decision P5(c),
 *                    `.claude/decisions/0006-rest-api-architect-design.md`).
 *   feature off    → the VARIANT section below. Injecting `Tracer` without the bridge
 *                    on the classpath doesn't cause a compile error: there's no bean, and the
 *                    context blows up at startup, far from the cause.
 *
 * ─── VARIANT: project without `feature: observability` ───────────────────────────────
 *
 * Remove the `tracer` field and the `io.micrometer.tracing` imports, and replace the
 * `currentTraceId()` of the class below with what follows. Everything else stays the same.
 * With `30-rest.md` § 8 not `none` the `admission` field keeps `@RequiredArgsConstructor`;
 * with no field left, `@RequiredArgsConstructor` and `@FieldDefaults` go too.
 *
 * The identifier stops correlating with a distributed trace and instead correlates
 * the response with this service's log line, and nothing else. This is a deliberate
 * degradation, allowed by `.claude/rules/observability.md` § Correlation, and the
 * method's Javadoc saying so is mandatory: without it nobody can tell this choice apart
 * from a missing configuration. Its text:
 *
 *    Without a tracing bridge on the classpath there's no `Tracer` bean, and injecting it
 *    would prevent the context from starting. The identifier is generated here: it meets
 *    the requirement that every 5xx carry correlation, without promising a distributed
 *    correlation this project doesn't have. To get that, enable `feature: observability`
 *    in the blueprint.
 *
 * The code:
 *
 *    private String currentTraceId() {
 *        return UUID.randomUUID().toString();
 *    }
 *
 * Additional import: java.util.UUID
 * ─────────────────────────────────────────────────────────────────────────────────────
 */
package com.exemplo.minhaapi.adapter.in.rest;

import com.exemplo.minhaapi.domain.exception.BusinessRuleViolationException;
import com.exemplo.minhaapi.domain.exception.ConflictException;
import com.exemplo.minhaapi.domain.exception.DependencyResponseException;
import com.exemplo.minhaapi.domain.exception.DependencyUnavailableException;
import com.exemplo.minhaapi.domain.exception.DomainException;
import com.exemplo.minhaapi.domain.exception.IntegrationException;
import com.exemplo.minhaapi.domain.exception.NotFoundException;
import com.exemplo.minhaapi.domain.exception.OutcomeUnknownException;
import com.exemplo.minhaapi.domain.exception.ValidationException;
import com.exemplo.minhaapi.adapter.in.rest.idempotent.IdempotencyKeyInterceptor;
import com.exemplo.minhaapi.adapter.in.rest.admission.AdmissionProperties;
import com.exemplo.minhaapi.adapter.in.rest.admission.QuotaExceededException;
import com.exemplo.minhaapi.adapter.in.rest.idempotent.MissingIdempotencyKeyException;
import io.micrometer.tracing.Span;
import io.github.resilience4j.bulkhead.BulkheadFullException;
import io.micrometer.tracing.Tracer;
import jakarta.servlet.http.HttpServletRequest;
import java.net.URI;
import java.time.Duration;
import java.util.List;
import lombok.AccessLevel;
import lombok.RequiredArgsConstructor;
import lombok.experimental.FieldDefaults;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.ProblemDetail;
import org.springframework.http.ResponseEntity;
import org.springframework.http.converter.HttpMessageNotReadableException;
import org.springframework.validation.FieldError;
import org.springframework.web.accept.InvalidApiVersionException;
import org.springframework.web.bind.MethodArgumentNotValidException;
import org.springframework.web.bind.annotation.ExceptionHandler;
import org.springframework.web.bind.annotation.RestControllerAdvice;
import org.springframework.web.method.annotation.MethodArgumentTypeMismatchException;

@RestControllerAdvice
@Slf4j
@RequiredArgsConstructor
@FieldDefaults(level = AccessLevel.PRIVATE, makeFinal = true)
public class ApiExceptionHandler {

    Tracer tracer;
    AdmissionProperties admission;

    @ExceptionHandler(NotFoundException.class)
    public ProblemDetail handleNotFound(NotFoundException e, HttpServletRequest request) {
        return problemDetail(HttpStatus.NOT_FOUND, e, request);
    }

    @ExceptionHandler(ValidationException.class)
    public ProblemDetail handleValidation(ValidationException e, HttpServletRequest request) {
        return problemDetail(HttpStatus.BAD_REQUEST, e, request);
    }

    /**
     * UNPROCESSABLE_CONTENT, not UNPROCESSABLE_ENTITY: RFC 9110 renamed the status and
     * Spring Framework 7 deprecated the old constant. The number is still 422.
     */
    @ExceptionHandler(BusinessRuleViolationException.class)
    public ProblemDetail handleBusinessRuleViolation(
            BusinessRuleViolationException e, HttpServletRequest request) {
        return problemDetail(HttpStatus.UNPROCESSABLE_CONTENT, e, request);
    }

    @ExceptionHandler(ConflictException.class)
    public ProblemDetail handleConflict(ConflictException e, HttpServletRequest request) {
        return problemDetail(HttpStatus.CONFLICT, e, request);
    }

    /**
     * The three integration families (`.claude/rules/error-handling.md` § Integration families):
     * another system failed, not this request. Present once the project calls something over the
     * network; until then these three handlers and their imports stay out.
     */
    @ExceptionHandler(DependencyResponseException.class)
    public ProblemDetail handleDependencyResponse(DependencyResponseException e, HttpServletRequest request) {
        return integrationProblem(HttpStatus.BAD_GATEWAY, e, request);
    }

    /**
     * `Retry-After` only when the dependency or the open circuit announced a wait — never an
     * invented one; the caller then backs off on its own policy.
     */
    @ExceptionHandler(DependencyUnavailableException.class)
    public ResponseEntity<ProblemDetail> handleDependencyUnavailable(
            DependencyUnavailableException e, HttpServletRequest request) {
        ResponseEntity.BodyBuilder response = ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE);
        e.retryAfter().ifPresent(wait -> response.header(HttpHeaders.RETRY_AFTER, Long.toString(wait.toSeconds())));
        return response.body(integrationProblem(HttpStatus.SERVICE_UNAVAILABLE, e, request));
    }

    @ExceptionHandler(OutcomeUnknownException.class)
    public ProblemDetail handleOutcomeUnknown(OutcomeUnknownException e, HttpServletRequest request) {
        return integrationProblem(HttpStatus.GATEWAY_TIMEOUT, e, request);
    }

    /**
     * Inbound admission (`.claude/rules/inbound-admission.md` § Rejection): the request was refused
     * before the use case ran, so it is neither a domain nor an integration family. Present once
     * `30-rest.md` § 8 is not `none`; until then these two handlers, the `admission` field and
     * their imports stay out. The caller's quota is spent: 429, `Retry-After` the window. Thrown
     * by the quota interceptor in `preHandle` — for a controller and for the GraphQL route alike.
     */
    @ExceptionHandler(QuotaExceededException.class)
    public ResponseEntity<ProblemDetail> handleQuotaExceeded(QuotaExceededException e, HttpServletRequest request) {
        log.warn("Quota {} spent at {} {}", e.limiter(), request.getMethod(), request.getRequestURI());
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(HttpStatus.TOO_MANY_REQUESTS, "Too many requests");
        problem.setInstance(URI.create(request.getRequestURI()));
        problem.setProperty("errorCode", "RATE_LIMITED");
        return ResponseEntity.status(HttpStatus.TOO_MANY_REQUESTS)
                .header(HttpHeaders.RETRY_AFTER, retryAfterSeconds(e.retryAfter()))
                .body(problem);
    }

    /**
     * The case's concurrency cap is full: 503 `SERVICE_BUSY`, `Retry-After` the recorded wait, and
     * `traceId` like every 5xx. Resilience4j's own exception, mapped as it arrives: every one that
     * reaches this advice is inbound, since an outbound adapter translates its own full bulkhead
     * into `DependencyUnavailableException` (`.claude/rules/http-client.md` § Failures). Raised by
     * the `@Bulkhead` aspect, which runs ahead of `IdempotencyAspect`: no key was claimed.
     */
    @ExceptionHandler(BulkheadFullException.class)
    public ResponseEntity<ProblemDetail> handleBusy(BulkheadFullException e, HttpServletRequest request) {
        String traceId = currentTraceId();
        log.warn("Cap {} full at {} [traceId={}]", e.getBulkheadName(), request.getRequestURI(), traceId);
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(HttpStatus.SERVICE_UNAVAILABLE, "Service busy");
        problem.setInstance(URI.create(request.getRequestURI()));
        problem.setProperty("errorCode", "SERVICE_BUSY");
        problem.setProperty("traceId", traceId);
        return ResponseEntity.status(HttpStatus.SERVICE_UNAVAILABLE)
                .header(HttpHeaders.RETRY_AFTER, retryAfterSeconds(admission.busyRetryAfter()))
                .body(problem);
    }

    /**
     * Structural, same family as bean validation below: the request never reached the use
     * case, so there's no domain exception and no `errorCode` — just `violations`, with the
     * header name as the offending "field" (`IdempotencyKeyInterceptor.java.example`).
     */
    @ExceptionHandler(MissingIdempotencyKeyException.class)
    public ProblemDetail handleMissingIdempotencyKey(MissingIdempotencyKeyException e, HttpServletRequest request) {
        log.warn("Missing/malformed Idempotency-Key at {} {}", request.getMethod(), request.getRequestURI());
        return invalidRequest(request, List.of(new Violation(IdempotencyKeyInterceptor.HEADER, e.getMessage())));
    }

    /**
     * A version outside `ApiVersioningConfig`'s supported list — never offered, or past its
     * sunset (`.claude/rules/api-rest.md` § Versioning). Structural: the request never
     * reached a controller, so `violations` on `version` and never `errorCode`. Also covers
     * `NotAcceptableApiVersionException`, its subclass, for a supported version no mapping
     * serves. Thrown while the handler is looked up, before any controller — this advice still
     * catches it (proven against Framework 7.0.9, `0150`). A path with no version segment at
     * all matches no mapping and answers 404: `MissingApiVersionException` never surfaces
     * with the path-segment strategy, so it has no handler here.
     */
    @ExceptionHandler(InvalidApiVersionException.class)
    public ProblemDetail handleUnsupportedApiVersion(InvalidApiVersionException e, HttpServletRequest request) {
        log.warn("Unsupported API version at {} {}", request.getMethod(), request.getRequestURI());
        return invalidRequest(request, List.of(new Violation("version", "is not a supported API version")));
    }

    /**
     * Bean validation is structural: the body never reached the domain. Carries `violations`
     * and never `errorCode` — there's no domain exception to supply it.
     */
    @ExceptionHandler(MethodArgumentNotValidException.class)
    public ProblemDetail handleBeanValidation(
            MethodArgumentNotValidException e, HttpServletRequest request) {
        List<Violation> violations =
                e.getBindingResult().getFieldErrors().stream()
                        .map(ApiExceptionHandler::toViolation)
                        .toList();
        log.warn("Bean validation failed at {} {}: {}", request.getMethod(), request.getRequestURI(), violations);
        return invalidRequest(request, violations);
    }

    /**
     * A path variable or query parameter that doesn't convert to its declared type — a
     * malformed UUID, text where a number goes — is structural too. Without this handler it
     * falls through to {@code handleUnexpected} and answers 500. The parameter name is the
     * offending "field"; the declared type stays out of the body.
     */
    @ExceptionHandler(MethodArgumentTypeMismatchException.class)
    public ProblemDetail handleTypeMismatch(
            MethodArgumentTypeMismatchException e, HttpServletRequest request) {
        log.warn("Type mismatch for {} at {} {}", e.getName(), request.getMethod(), request.getRequestURI());
        return invalidRequest(request, List.of(new Violation(e.getName(), "has an invalid format")));
    }

    /**
     * Malformed JSON, incompatible type, or unknown enum: 400 shape-wise, no
     * per-field violations — deserialization stopped before there were any fields. The log
     * line names the cause's type and never takes {@code e}: the parser's message can echo
     * a fragment of the body it failed on (`.claude/rules/logging.md` § Format and level).
     */
    @ExceptionHandler(HttpMessageNotReadableException.class)
    public ProblemDetail handleUnreadableBody(
            HttpMessageNotReadableException e, HttpServletRequest request) {
        log.warn("Unreadable body at {} {}: {}", request.getMethod(), request.getRequestURI(),
                e.getMostSpecificCause().getClass().getSimpleName());
        ProblemDetail problem =
                ProblemDetail.forStatusAndDetail(HttpStatus.BAD_REQUEST, "Invalid request body");
        problem.setInstance(URI.create(request.getRequestURI()));
        return problem;
    }

    /**
     * Fallback — the only untyped exception allowed to exist here: it's the handler
     * that catches what escaped, not code that throws it. Never leaks the real
     * message/stack trace in the body — that stays in the log only, tied by traceId.
     *
     * A single value, computed once, written in both places. The rule requires the
     * identifier in the body to be *the same* as the one that went into the log; calling
     * it twice would leave that to chance.
     */
    @ExceptionHandler(Exception.class)
    public ProblemDetail handleUnexpected(Exception e, HttpServletRequest request) {
        String traceId = currentTraceId();
        log.error("Unmapped error at {} [traceId={}]", request.getRequestURI(), traceId, e);
        ProblemDetail problem =
                ProblemDetail.forStatusAndDetail(HttpStatus.INTERNAL_SERVER_ERROR, "Internal error");
        problem.setInstance(URI.create(request.getRequestURI()));
        problem.setProperty("traceId", traceId);
        return problem;
    }

    /**
     * The one place the structural 400 is built: every handler that reports `violations`
     * goes through here, so its `detail` and property name are written once.
     */
    private static ProblemDetail invalidRequest(HttpServletRequest request, List<Violation> violations) {
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(HttpStatus.BAD_REQUEST, "Invalid request");
        problem.setInstance(URI.create(request.getRequestURI()));
        problem.setProperty("violations", violations);
        return problem;
    }

    private ProblemDetail problemDetail(HttpStatus status, DomainException e, HttpServletRequest request) {
        log.warn("{} at {}: {}", e.errorCode(), request.getRequestURI(), e.getMessage());
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(status, e.getMessage());
        problem.setInstance(URI.create(request.getRequestURI()));
        problem.setProperty("errorCode", e.errorCode());
        return problem;
    }

    /**
     * A 5xx with a generic `detail`, `errorCode` and `traceId`. Which dependency failed goes to the
     * log, never to the body: it is an operational fact, and naming a provider to the caller leaks
     * the architecture.
     */
    private ProblemDetail integrationProblem(HttpStatus status, IntegrationException e, HttpServletRequest request) {
        String traceId = currentTraceId();
        log.warn("{} from {} at {} [traceId={}]: {}", e.errorCode(), e.dependency(), request.getRequestURI(), traceId,
                e.getMessage());
        ProblemDetail problem = ProblemDetail.forStatusAndDetail(status, "A dependency failed");
        problem.setInstance(URI.create(request.getRequestURI()));
        problem.setProperty("errorCode", e.errorCode());
        problem.setProperty("traceId", traceId);
        return problem;
    }

    /**
     * No traceId outside an active span. Returning "unavailable" keeps the field
     * present on every 5xx, as the rule requires, and tells the truth about what happened.
     */
    private String currentTraceId() {
        Span span = tracer.currentSpan();
        return span == null ? "unavailable" : span.context().traceId();
    }

    /** Whole seconds, rounded up: a wait shorter than announced makes the retry fail again. */
    private static String retryAfterSeconds(Duration wait) {
        return Long.toString(Math.ceilDiv(wait.toMillis(), 1000L));
    }

    private static Violation toViolation(FieldError error) {
        return new Violation(error.getField(), error.getDefaultMessage());
    }

    public record Violation(String field, String message) {}
}
