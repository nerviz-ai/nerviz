<!--
  EXEMPLAR — SonarQube scanner in the ROOT pom.xml. Two fragments, merged into what the
  file already has; never a second <properties> or <pluginManagement> block.
  DO NOT pin versions based on this file: it's a reference for SHAPE.

  No token here, ever. The scanner reads SONAR_TOKEN from the environment on its own —
  the developer's shell locally, the repository secret in CI.
-->

<!-- 1 · Into <properties> -->
<!-- Resolved at runtime from repo1.maven.org maven-metadata.xml, never from memory. -->
<sonar.plugin.version><!-- resolved in step 3 --></sonar.plugin.version>
<!-- <groupId>:<artifactId> of this POM. -->
<sonar.projectKey>com.exemplo:minha-api</sonar.projectKey>
<!-- The server URL from step 2, or http://localhost:9000 for the local container.
     A URL is not a secret; the token is, and it is not here. -->
<sonar.host.url>http://localhost:9000</sonar.host.url>
<!-- SonarCloud only — delete the line otherwise. -->
<sonar.organization>my-org</sonar.organization>
<!-- No sonar.coverage.jacoco.xmlReportPaths: the scanner's default,
     target/site/jacoco/jacoco.xml, is exactly where the jacoco-maven-plugin `report`
     execution writes, module by module. -->
<!-- The coverage scope: the jacoco-maven-plugin <excludes> of THIS pom.xml, each `.class`
     turned into `.java`, comma-separated — derived in step 3, never copied from here.
     Without it, the classes JaCoCo leaves out reach Sonar as uncovered. Coverage only:
     never sonar.exclusions, the classes are still analyzed for issues. -->
<sonar.coverage.exclusions><!-- derived in step 3 --></sonar.coverage.exclusions>
<!-- Findings accepted by design in code the framework's own templates ship, one entry
     each, scoped by rule AND file — never a rule switched off project-wide. Each Java
     template carries a comment pointing back here; remove the entry together with the
     code it covers. A file that doesn't exist in this project matches nothing.
       s2326 · IdempotentOutcome<R>: R exists so Executed<R> and Replayed<R> share one
               sealed type; the interface body never names it.
       s112  · IdempotencyAspect#aroundIdempotent declares `throws Throwable` because
               ProceedingJoinPoint#proceed() does — the Checkstyle IllegalThrows
               suppression in checkstyle.xml covers the same line.
       s4502 · SecurityConfig disables CSRF because no cookie authenticates a request —
               the condition .claude/rules/authorization.md § Transport hardening owns.
               The day a cookie does, CSRF goes back on and this entry goes with it. -->
<sonar.issue.ignore.multicriteria>s2326,s112,s4502</sonar.issue.ignore.multicriteria>
<sonar.issue.ignore.multicriteria.s2326.ruleKey>java:S2326</sonar.issue.ignore.multicriteria.s2326.ruleKey>
<sonar.issue.ignore.multicriteria.s2326.resourceKey>**/IdempotentOutcome.java</sonar.issue.ignore.multicriteria.s2326.resourceKey>
<sonar.issue.ignore.multicriteria.s112.ruleKey>java:S112</sonar.issue.ignore.multicriteria.s112.ruleKey>
<sonar.issue.ignore.multicriteria.s112.resourceKey>**/IdempotencyAspect.java</sonar.issue.ignore.multicriteria.s112.resourceKey>
<sonar.issue.ignore.multicriteria.s4502.ruleKey>java:S4502</sonar.issue.ignore.multicriteria.s4502.ruleKey>
<sonar.issue.ignore.multicriteria.s4502.resourceKey>**/SecurityConfig.java</sonar.issue.ignore.multicriteria.s4502.resourceKey>

<!-- 2 · Into <build><pluginManagement><plugins> -->
<!-- In pluginManagement, not <plugins>: it binds to no phase, so `verify` never
     reaches a server. The version declared here is what makes the short `sonar:sonar`
     resolve to this plugin at this version:  ./mvnw -B verify sonar:sonar -->
<plugin>
  <groupId>org.sonarsource.scanner.maven</groupId>
  <artifactId>sonar-maven-plugin</artifactId>
  <version>${sonar.plugin.version}</version>
</plugin>
